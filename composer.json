{
    "name": "sglms/inverse-logistics",
    "description": "Inverse logistics domain service package for Laravel",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Sglms\\InverseLogistics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sglms\\InverseLogistics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sglms\\InverseLogistics\\Providers\\InverseLogisticsServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^4.3",
        "livewire/flux": "^2.14"
    },
    "require-dev": {
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "pint": "pint"
    }
}
